# ══════════ .NET 构建产物 ══════════
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# ══════════ 发布 / 分发产物 ══════════
# dist/ 是 dotnet publish 后的产物目录（含 exe、settings.json、logs/）
/dist/

# ══════════ 运行时生成（与 exe 同目录）══════════
/settings.json
/logs/

# ══════════ 内部文档（技术与审查记录，不对外发布）══════════
/docs/

# ══════════ 图标生成脚本（一次性工具，不随源码发布）══════════
/tools/

# ══════════ 独立 Web 站点（另行托管，不进本仓库）══════════
/BtBattery 下载页/

# ══════════ 本地助手工作目录 ══════════
/.workbuddy/
/.workbuddy-ai/
